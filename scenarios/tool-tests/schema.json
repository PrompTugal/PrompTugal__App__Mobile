{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "abp-tooltest/1",
 "title": "abp-tooltest/1: one file of tool-test cases of one kind",
 "description": "Platform-neutral. UTF-8 JSON. Cases are synthetic; tools are fakes; nothing executes. See docs/experiments/README.md.",
 "type": "object",
 "required": [
  "format",
  "version",
  "synthetic",
  "kind",
  "title",
  "cases"
 ],
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "abp-tooltest/1"
  },
  "version": {
   "type": "string",
   "minLength": 1,
   "description": "The content version of this file, bumped when its cases change."
  },
  "synthetic": {
   "const": true
  },
  "kind": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,39}$"
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "items": {
    "$ref": "#/$defs/case"
   }
  },
  "judges": {
   "type": "array",
   "maxItems": 3,
   "uniqueItems": true,
   "description": "Optional. The judge layers this file's cases are run through, at most one per layer. The code layer is always authoritative; model layers add an opinion and every disagreement is recorded. Each case may also carry its own `judges {ask, expect}`.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "layer"
    ],
    "properties": {
     "layer": {
      "enum": [
       "code",
       "local",
       "cloud"
      ]
     },
     "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Optional model id, for the local and cloud layers."
     },
     "prompt_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/._-]{0,99}$",
      "description": "The judge prompt: an id such as tool-output, or a path such as prompts/judges/tool-output.json. Required for local and cloud, absent for code."
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "layer": {
         "const": "code"
        }
       }
      },
      "then": {
       "not": {
        "anyOf": [
         {
          "required": [
           "model"
          ]
         },
         {
          "required": [
           "prompt_ref"
          ]
         }
        ]
       }
      },
      "else": {
       "required": [
        "prompt_ref"
       ]
      }
     }
    ]
   }
  }
 },
 "$defs": {
  "case": {
   "type": "object",
   "required": [
    "id",
    "tests",
    "tools",
    "fake_tools",
    "messages",
    "checks"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "tests": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200,
     "pattern": "^[^\\n]*$",
     "description": "One line: what this case tests."
    },
    "system": {
     "type": "string",
     "description": "Optional system prompt."
    },
    "messages": {
     "type": "array",
     "minItems": 1,
     "maxItems": 12,
     "items": {
      "$ref": "#/$defs/message"
     },
     "description": "The starting conversation. The first message is the user's."
    },
    "tools": {
     "type": "array",
     "minItems": 2,
     "maxItems": 5,
     "items": {
      "$ref": "#/$defs/tool"
     }
    },
    "fake_tools": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/fakeTool"
     },
     "description": "One entry per offered tool, and no others. A fake returns canned data and touches nothing."
    },
    "checks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "oneOf": [
       {
        "$ref": "#/$defs/check_tool_called"
       },
       {
        "$ref": "#/$defs/check_tools_called_in_order"
       },
       {
        "$ref": "#/$defs/check_args_valid"
       },
       {
        "$ref": "#/$defs/check_args_equal"
       },
       {
        "$ref": "#/$defs/check_no_tool"
       },
       {
        "$ref": "#/$defs/check_no_unoffered_tool"
       },
       {
        "$ref": "#/$defs/check_value_absent"
       },
       {
        "$ref": "#/$defs/check_answers_after_result"
       },
       {
        "$ref": "#/$defs/check_max_calls"
       },
       {
        "$ref": "#/$defs/check_answer_contains"
       }
      ]
     }
    },
    "max_steps": {
     "type": "integer",
     "minimum": 1,
     "maximum": 6,
     "default": 3,
     "description": "Model turns allowed."
    },
    "reference": {
     "$ref": "#/$defs/run",
     "description": "A scripted run that must pass every check. For testing an implementation of the checker."
    },
    "wrong": {
     "$ref": "#/$defs/run",
     "description": "A scripted run that must fail at least one check."
    },
    "judges": {
     "type": "object",
     "required": [
      "ask",
      "expect"
     ],
     "additionalProperties": false,
     "properties": {
      "ask": {
       "type": "string",
       "minLength": 1,
       "maxLength": 400,
       "description": "One question for a model judge about the output under test."
      },
      "expect": {
       "enum": [
        "pass",
        "fail"
       ],
       "description": "The verdict a correct judge gives for the reference run."
      }
     }
    }
   }
  },
  "tool": {
   "type": "object",
   "required": [
    "name",
    "description",
    "parameters"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "description": {
     "type": "string",
     "minLength": 1
    },
    "parameters": {
     "type": "object",
     "required": [
      "type",
      "properties"
     ],
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "object"
      },
      "properties": {
       "type": "object",
       "maxProperties": 6,
       "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
       },
       "additionalProperties": {
        "type": "object",
        "required": [
         "type"
        ],
        "properties": {
         "type": {
          "enum": [
           "string",
           "integer",
           "number",
           "boolean"
          ]
         },
         "description": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      },
      "required": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
       }
      }
     }
    }
   }
  },
  "fakeTool": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "returns": {
     "description": "A canned result: any JSON value."
    },
    "by": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "table": {
     "type": "object"
    },
    "default": {}
   },
   "anyOf": [
    {
     "required": [
      "returns"
     ]
    },
    {
     "required": [
      "by",
      "table"
     ]
    }
   ]
  },
  "message": {
   "type": "object",
   "required": [
    "role"
   ],
   "additionalProperties": false,
   "properties": {
    "role": {
     "enum": [
      "user",
      "assistant",
      "tool"
     ]
    },
    "text": {
     "type": "string"
    },
    "name": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,39}$",
     "description": "Required for role tool: the tool whose result this is."
    },
    "tool_calls": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
       },
       "arguments": {
        "type": "object"
       }
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "role": {
        "const": "tool"
       }
      },
      "required": [
       "role"
      ]
     },
     "then": {
      "required": [
       "name"
      ]
     }
    }
   ]
  },
  "run": {
   "type": "object",
   "required": [
    "steps"
   ],
   "additionalProperties": false,
   "properties": {
    "steps": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "text": {
        "type": "string"
       },
       "calls": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "name"
         ],
         "additionalProperties": false,
         "properties": {
          "name": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "arguments": {
           "type": "object"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "check_tool_called": {
   "type": "object",
   "description": "The tool was called (position any), or was the first call (position first). By name, whatever the arguments.",
   "required": [
    "kind",
    "name"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "tool_called"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "name": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "position": {
     "enum": [
      "any",
      "first"
     ],
     "default": "any"
    }
   }
  },
  "check_tools_called_in_order": {
   "type": "object",
   "description": "The calls, in order, are exactly these tools.",
   "required": [
    "kind",
    "names"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "tools_called_in_order"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "names": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
     }
    }
   }
  },
  "check_args_valid": {
   "type": "object",
   "description": "At least one call, and every call is accepted by the argument check: names, required arguments, types, length limits.",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "args_valid"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    }
   }
  },
  "check_args_equal": {
   "type": "object",
   "description": "An accepted call to the tool has this argument value. exact needs value; ci needs a string value (case-insensitive, trimmed); contains needs a non-empty string value (case-insensitive); range needs min <= max (a number); one_of needs values (case-insensitive strings).",
   "required": [
    "kind",
    "name",
    "arg",
    "rule"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "args_equal"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "name": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "arg": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "which": {
     "enum": [
      "first",
      "last",
      "any"
     ],
     "default": "first"
    },
    "rule": {
     "enum": [
      "exact",
      "ci",
      "contains",
      "range",
      "one_of"
     ]
    },
    "value": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "values": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "rule": {
        "const": "exact"
       }
      },
      "required": [
       "rule"
      ]
     },
     "then": {
      "required": [
       "value"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "rule": {
        "const": "ci"
       }
      },
      "required": [
       "rule"
      ]
     },
     "then": {
      "required": [
       "value"
      ],
      "properties": {
       "value": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "rule": {
        "const": "contains"
       }
      },
      "required": [
       "rule"
      ]
     },
     "then": {
      "required": [
       "value"
      ],
      "properties": {
       "value": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "rule": {
        "const": "range"
       }
      },
      "required": [
       "rule"
      ]
     },
     "then": {
      "required": [
       "min",
       "max"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "rule": {
        "const": "one_of"
       }
      },
      "required": [
       "rule"
      ]
     },
     "then": {
      "required": [
       "values"
      ]
     }
    }
   ]
  },
  "check_no_tool": {
   "type": "object",
   "description": "No tool call at all, and the model answered in text.",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "no_tool"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    }
   }
  },
  "check_no_unoffered_tool": {
   "type": "object",
   "description": "Every call names a tool that was offered (no made-up tool).",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "no_unoffered_tool"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    }
   }
  },
  "check_value_absent": {
   "type": "object",
   "description": "The value appears in no call's arguments. Compared on the raw argument text, ignoring case and anything that is not a letter or digit.",
   "required": [
    "kind",
    "value"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "value_absent"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "value": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "check_answers_after_result": {
   "type": "object",
   "description": "The last step made no call and the final text is not empty; when contains is given, the text contains at least one of the words (case-insensitive).",
   "required": [
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "answers_after_result"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "contains": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "check_max_calls": {
   "type": "object",
   "description": "At most this many calls.",
   "required": [
    "kind",
    "max"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "max_calls"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "max": {
     "type": "integer",
     "minimum": 0,
     "maximum": 10
    }
   }
  },
  "check_answer_contains": {
   "type": "object",
   "description": "The final text contains at least one of the words (case-insensitive).",
   "required": [
    "kind",
    "any"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "answer_contains"
    },
    "label": {
     "type": "string",
     "description": "Optional one-line description shown with a failure."
    },
    "any": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
